url: "https://unicode-logic-kit.readthedocs.io/"
keywords:
  - logic
  - first-order-logic
  - modal-logic
  - description-logic
  - higher-order-logic
  - non-classical-logic
  - theorem-proving
  - automated-reasoning
  - model-checking
  - semantic-parsing
  - autoformalization
  - NL-to-FOL
version: 0.35.0
